{
    "appId": "com.personal.todolist",
    "appName": "Todo List",
    "webDir": "src",
    "server": {
        "androidScheme": "https"
    },
    "android": {
        "allowMixedContent": true,
        "backgroundColor": "#f0f2f7"
    },
    "plugins": {
        "FirebaseAuthentication": {
            "skipNativeAuth": true,
            "providers": [
                "google.com"
            ]
        }
    }
}