{
    "name": "todo-app",
    "version": "1.0.1",
    "description": "Todo List Desktop App — Personal Edition",
    "main": "main.js",
    "author": "Personal",
    "private": true,
    "scripts": {
        "start": "electron .",
        "build-icon": "node scripts/generate-icon.js",
        "clean": "node -e \"const fs=require('fs');if(fs.existsSync('todo-dist')){fs.rmSync('todo-dist',{recursive:true,force:true});}\"",
        "pack": "npm run clean && npm run build-icon && electron-builder --dir",
        "dist": "npm run clean && npm run build-icon && electron-builder",
        "dist:win": "npm run clean && npm run build-icon && electron-builder --win",
        "dist:linux": "npm run clean && npm run build-icon && electron-builder --linux",
        "dist:portable": "npm run clean && npm run build-icon && electron-builder --win portable",
        "android:sync": "npx cap sync android",
        "android:open": "npx cap sync android && npx cap open android",
        "android:apk": "npx cap sync android && cd android && ./gradlew assembleDebug",
        "version": "sed -i \"s/versionName \\\".*\\\"/versionName \\\"$npm_package_version\\\"/\" android/app/build.gradle && git add android/app/build.gradle"
    },
    "dependencies": {
        "@capacitor-firebase/authentication": "^6.3.1",
        "@capacitor/core": "^6.2.0",
        "@capacitor/local-notifications": "^6.0.0"
    },
    "devDependencies": {
        "@capacitor/android": "^6.2.0",
        "@capacitor/cli": "^6.2.0",
        "electron": "^28.3.3",
        "electron-builder": "^24.13.3",
        "jimp": "0.16.13"
    },
    "build": {
        "appId": "com.personal.todolist",
        "productName": "Todo List",
        "copyright": "Personal Use Only",
        "publish": null,
        "asar": true,
        "directories": {
            "output": "todo-dist"
        },
        "win": {
            "icon": "src/assets/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "requestedExecutionLevel": "asInvoker"
        },
        "linux": {
            "icon": "assets/icon.png",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "Utility"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Todo List",
            "uninstallDisplayName": "Todo List",
            "deleteAppDataOnUninstall": false
        },
        "portable": {
            "artifactName": "TodoList-Portable-${version}.exe"
        },
        "files": [
            "**/*",
            "!scripts/**",
            "!todo-dist/**",
            "!node_modules/**",
            "!*.md",
            "!.git/**"
        ]
    }
}
